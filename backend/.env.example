# Copy to backend/.env (or project-root .env) and fill in what you have.
# EVERY key is optional - with no keys the app runs in zero-API-key mode and
# those providers show "Not configured". Keys stay in the backend; the React
# app never sees them. Never commit your real .env.

# ---- Threat-intelligence providers ----
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
IPQS_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# ---- MaxMind GeoLite2 (offline city/ASN). Download the .mmdb files with a free
# MaxMind account and put them here (paths are relative to where you start uvicorn,
# absolute paths are safest).
# MAXMIND_CITY_DB_PATH=data/GeoLite2-City.mmdb
# MAXMIND_ASN_DB_PATH=data/GeoLite2-ASN.mmdb

# ---- IPQualityScore behaviour ----
IPQS_STRICTNESS=0                 # 0 = fewest false positives (max 3)
IPQS_PREMIUM_FIELDS=false         # true only on a paid plan (active_vpn/active_tor/...)
IPQS_MAX_LOOKUPS_PER_ANALYSIS=2   # protects the 1,000/month free quota

# ---- Other budgets / behaviour ----
VT_MAX_LOOKUPS_PER_ANALYSIS=4     # VirusTotal public API: 4 req/min, 500/day
PROVIDER_BACKOFF_HOURS=24         # pause a provider after "quota exhausted"
ENABLE_DNS=true
ENABLE_RDAP=true
ENABLE_PUBLIC_FEEDS=true          # Tor exit list + OpenPhish community feed (no key)
PROTECTED_DOMAINS=ntbank.example  # your organisation's domains (look-alike detection)

# ---- Timeouts (seconds) and cache TTLs (hours) ----
HTTP_TIMEOUT_SECONDS=8
DNS_TIMEOUT_SECONDS=3
CACHE_TTL_HOURS=24
CACHE_TTL_UNKNOWN_HOURS=6
CACHE_TTL_RDAP_HOURS=168
CACHE_TTL_FEED_HOURS=6

# ---- App ----
# DATABASE_URL=sqlite:///data/sih_email_intel.db
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
